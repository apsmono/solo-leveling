# Notion
NOTION_API_TOKEN=

# Stage 8 workflow target (Notion page ID where workflow outputs are created)
NOTION_WORKFLOW_PARENT_ID=

# Google Drive service account JSON
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_CREDENTIALS_JSON=

# Gmail OAuth client credentials JSON (Desktop app)
GMAIL_CREDENTIALS_PATH=
GMAIL_CREDENTIALS_JSON=

# Legacy shared Google credentials path (backward-compatible fallback)
GOOGLE_CREDENTIALS_PATH=
GOOGLE_CREDENTIALS_JSON=

# AI agents (Gemini is primary; Kimi is supported)
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Kimi (Moonshot) — alternative provider
KIMI_API_KEY=
KIMI_MODEL=kimi-for-coding
KIMI_BASE_URL=https://api.kimi.com/coding/v1
# KIMI_USER_AGENT=          # optional — override the default User-Agent

# Gmail OAuth2 token cache (auto-created on first login, never commit)
GMAIL_TOKEN_PATH=.gmail_token.json

# Feature flags
# Set to false to disable Gmail integration without removing credentials (default: true)
GMAIL_ENABLED=true

# Scheduler / reminders
REMINDER_STORE_PATH=data/reminders.json
SCHEDULER_POLL_SECONDS=30

# Optional daily proactive Gmail digest (logged by scheduler)
DAILY_GMAIL_DIGEST_ENABLED=false
DAILY_GMAIL_DIGEST_HOUR=8
DAILY_GMAIL_DIGEST_MINUTE=0

# Optional weekly Stage 9 library maintenance reminder (logged by scheduler)
LIBRARY_MAINTENANCE_ENABLED=false
LIBRARY_MAINTENANCE_DAY=sun
LIBRARY_MAINTENANCE_HOUR=9
LIBRARY_MAINTENANCE_MINUTE=0

# GitHub (cross-repo orchestration)
# Fine-grained PAT with repo (read), issues (write), actions (write)
GITHUB_PAT=

# Telegram Bot
# Get token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Optional: secret token for webhook verification (sent as X-Telegram-Bot-Api-Secret-Token header)
TELEGRAM_WEBHOOK_SECRET=

# Firebase
# Path to service account JSON or inline JSON for Admin SDK
FIREBASE_CREDENTIALS_PATH=./.credentials/firebase/service_account.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
ALLOWED_USER_EMAIL=
# Set to true to store reminders in Firestore instead of local JSON
USE_FIRESTORE_REMINDERS=false
# Set to true to store library entries in Firestore (dual-write, local files remain)
USE_FIRESTORE_LIBRARY=false

# Discord Bot
# Create bot at https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Signal / Vector DB (Phase 1)
# Postgres connection string for pgvector (use pgvector/pgvector:pg16 image)
SIGNAL_POSTGRES_DSN=postgresql://signal:changeme@localhost:5432/signal
# Owner identifier — defaults to ALLOWED_USER_EMAIL if not set
SIGNAL_OWNER_ID=
# Cosine distance threshold for token-cache dedup (0.08 ≈ similarity 0.92)
SIGNAL_COSINE_THRESHOLD=0.08
# Test DSN for integration tests (skipped if not set)
SIGNAL_POSTGRES_DSN_TEST=

# Signal / AI Guide (Phase 3)
# Gemini model for intent parsing (default: same as GEMINI_MODEL)
SIGNAL_INTENT_LLM_MODEL=
# Enable/disable LLM intent parsing fallback to keyword map
SIGNAL_INTENT_KEYWORD_FALLBACK=true
